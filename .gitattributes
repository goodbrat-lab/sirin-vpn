# Enforce LF line endings for scripts, Go, Kotlin, and OpenWrt files
* text=auto

*.sh text eol=lf
*.go text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

apps/router/luci-app-sirin/root/usr/libexec/rpcd/* text eol=lf
apps/router/init.d/* text eol=lf
apps/router/hotplug.d/* text eol=lf
.githooks/* text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf
