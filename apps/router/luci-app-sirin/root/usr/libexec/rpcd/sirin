            }
        ' "$CONFIG_FILE")
        [ -n "$sm" ] && split_mode="$sm"
    fi

    raw="Режим: $split_mode"
    if [ "$split_mode" = "only" ]; then
        raw="Split (Only): через VPN идут только адреса из split-списка, остальное напрямую"
    else
        if [ "$rudirect_via_tunnel" = "false" ]; then
            raw="RuDirect (Bypass): трафик РФ идёт напрямую через WAN"
        else
            raw="ВНИМАНИЕ: трафик РФ идёт через VPN"
        fi
    fi

    printf '{"ok":true,"public_ip":"%s","ip_ok":%s,"rudirect_via_tunnel":%s,"split_mode":"%s","raw":"%s"}\n' \
        "$public_ip" "$ip_ok" "$rudirect_via_tunnel" "$split_mode" "$raw"
}

detect_pkg_mgr() {
    if [ -x /sbin/apk ] || command -v apk >/dev/null 2>&1; then
        echo "apk"
    else
        echo "opkg"
    fi
}

detect_arch() {
    raw_arch=$(uname -m 2>/dev/null || opkg print-architecture 2>/dev/null | awk '{print $2}' | tail -n1 || echo "")
    case "$raw_arch" in
        x86_64|amd64) echo "x86_64" ;;
        aarch64|arm64) echo "arm64" ;;
        armv7*|armv6*|armhf|arm) echo "armv7" ;;
        mips64*) echo "mips" ;;
        mips*)
            if [ -f /proc/cpuinfo ] && grep -qi "little endian" /proc/cpuinfo; then
                echo "mipsle"
            elif echo "$raw_arch" | grep -qi "el"; then
                echo "mipsle"
            else
                echo "mips"
            fi
            ;;
        *)
            echo "mipsle"
            ;;
    esac
}

is_version_newer() {
    v1=$(echo "$1" | sed 's/^[a-zA-Z-]*//' | sed 's/-.*$//')
    v2=$(echo "$2" | sed 's/^[a-zA-Z-]*//' | sed 's/-.*$//')

    v1_1=$(echo "$v1" | cut -d. -f1); [ -z "$v1_1" ] && v1_1=0
    v1_2=$(echo "$v1" | cut -d. -f2); [ -z "$v1_2" ] && v1_2=0
    v1_3=$(echo "$v1" | cut -d. -f3); [ -z "$v1_3" ] && v1_3=0

    v2_1=$(echo "$v2" | cut -d. -f1); [ -z "$v2_1" ] && v2_1=0
    v2_2=$(echo "$v2" | cut -d. -f2); [ -z "$v2_2" ] && v2_2=0
    v2_3=$(echo "$v2" | cut -d. -f3); [ -z "$v2_3" ] && v2_3=0

    if [ "$v2_1" -gt "$v1_1" ] 2>/dev/null; then return 0; fi
    if [ "$v2_1" -lt "$v1_1" ] 2>/dev/null; then return 1; fi
    if [ "$v2_2" -gt "$v1_2" ] 2>/dev/null; then return 0; fi
    if [ "$v2_2" -lt "$v1_2" ] 2>/dev/null; then return 1; fi
    if [ "$v2_3" -gt "$v1_3" ] 2>/dev/null; then return 0; fi
    return 1
}

fetch_url() {
    url="$1"
    if command -v curl >/dev/null 2>&1; then
        curl -s -L -H "User-Agent: sirin-router-updater" --max-time 15 "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO- --header="User-Agent: sirin-router-updater" --timeout=15 "$url" 2>/dev/null
    else
        return 1
    fi
}

download_file() {
    url="$1"
    dest="$2"
    if command -v curl >/dev/null 2>&1; then
        curl -s -L -H "User-Agent: sirin-router-updater" --max-time 120 -o "$dest" "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$dest" --header="User-Agent: sirin-router-updater" --timeout=120 "$url" 2>/dev/null
    else
        return 1
    fi
}

method_check_update() {
    pkg_mgr=$(detect_pkg_mgr)
    arch=$(detect_arch)
    
    api_url="https://api.github.com/repos/goodbrat-lab/sirin-vpn/releases"
    json_data=$(fetch_url "$api_url")
    
    if [ -z "$json_data" ]; then
        json_data=$(fetch_url "https://api.github.com/repos/goodbrat-lab/sirin-vpn/releases/latest")
    fi
    
    if [ -z "$json_data" ]; then
        printf '{"ok":false,"error":"Не удалось подключиться к GitHub Releases API (проверьте интернет или DNS)","current_version":"%s","pkg_mgr":"%s","arch":"%s"}\n' \
            "$VERSION" "$pkg_mgr" "$arch"
        return
    fi
    
    if echo "$json_data" | grep -qi "API rate limit exceeded"; then
        printf '{"ok":false,"error":"Превышен лимит запросов к GitHub API. Попробуйте позже.","current_version":"%s","pkg_mgr":"%s","arch":"%s"}\n' \
            "$VERSION" "$pkg_mgr" "$arch"
        return
    fi

    parsed=$(echo "$json_data" | awk -v cur_arch="$arch" -v cur_pkg="$pkg_mgr" '
    BEGIN {
        tag = ""
        asset_name = ""
        asset_url = ""
    }
    /"tag_name"[ \t]*:[ \t]*"[^"]+"/ {
        if (tag == "") {
            match($0, /"tag_name"[ \t]*:[ \t]*"[^"]+"/)
            s = substr($0, RSTART, RLENGTH)
            sub(/^"tag_name"[ \t]*:[ \t]*"/, "", s)
            sub(/"$/, "", s)
            tag = s
        }
    }
    /"browser_download_url"[ \t]*:[ \t]*"[^"]+"/ {
        match($0, /"browser_download_url"[ \t]*:[ \t]*"[^"]+"/)
        s = substr($0, RSTART, RLENGTH)
        sub(/^"browser_download_url"[ \t]*:[ \t]*"/, "", s)
        sub(/"$/, "", s)
        
        is_match = 0
        if (cur_pkg == "apk") {
            if (s ~ /\.apk$/ && s ~ ("sirin-full.*" cur_arch)) is_match = 1
        } else {
            if (s ~ /\.ipk$/ && s ~ ("sirin-full.*" cur_arch)) is_match = 1
        }
        
        if (is_match && asset_url == "") {
            asset_url = s
            n = split(s, parts, "/")
            asset_name = parts[n]
        }
    }
    END {
        print tag "\t" asset_name "\t" asset_url
    }')

    rel_tag=$(echo "$parsed" | cut -f1)
    asset_name=$(echo "$parsed" | cut -f2)
    asset_url=$(echo "$parsed" | cut -f3)

    if [ -z "$rel_tag" ]; then
        printf '{"ok":true,"update_available":false,"current_version":"%s","latest_version":"%s","pkg_mgr":"%s","arch":"%s"}\n' \
            "$VERSION" "$VERSION" "$pkg_mgr" "$arch"
        return
    fi

    latest_ver=$(echo "$rel_tag" | sed 's/^[a-zA-Z-]*//')

    update_avail=false
    if is_version_newer "$VERSION" "$latest_ver"; then
        update_avail=true
    fi

    notes=$(echo "$json_data" | grep -m1 '"body":' | sed 's/^[ \t]*"body":[ \t]*"//' | sed 's/"[ \t]*$//' | head -c 200 | tr '\r\n\t"' '   ')

    printf '{"ok":true,"update_available":%s,"current_version":"%s","latest_version":"%s","tag":"%s","pkg_mgr":"%s","arch":"%s","asset_name":"%s","asset_url":"%s","release_notes":"%s"}\n' \
        "$update_avail" "$VERSION" "$latest_ver" "$rel_tag" "$pkg_mgr" "$arch" "$asset_name" "$asset_url" "$notes"
}

method_upgrade() {
    input="$1"
    url=""
    if [ -n "$input" ]; then
        url=$(echo "$input" | awk -F'"url"[ \t]*:[ \t]*"' '{print $2}' | cut -d'"' -f1)
    fi

    pkg_mgr=$(detect_pkg_mgr)
    arch=$(detect_arch)

    if [ -z "$url" ]; then
        chk=$(method_check_update)
        url=$(echo "$chk" | awk -F'"asset_url"[ \t]*:[ \t]*"' '{print $2}' | cut -d'"' -f1)
    fi

    if [ -z "$url" ]; then
        printf '{"ok":false,"error":"Не найден URL для скачивания пакета обновления (%s/%s)"}\n' "$arch" "$pkg_mgr"
        return
    fi

    tmp_pkg="/tmp/sirin_update.pkg"
    rm -f "$tmp_pkg"

    if ! download_file "$url" "$tmp_pkg"; then
        rm -f "$tmp_pkg"
        printf '{"ok":false,"error":"Ошибка скачивания пакета обновления с %s"}\n' "$url"
        return
    fi

    size=$(wc -c < "$tmp_pkg" 2>/dev/null || echo 0)
    if [ "$size" -lt 50000 ]; then
        rm -f "$tmp_pkg"
        printf '{"ok":false,"error":"Скачанный файл повреждён или слишком мал (%d байт)"}\n' "$size"
        return
    fi

    install_out=""
    ret=0
    if [ "$pkg_mgr" = "apk" ]; then
        install_out=$(apk add --allow-untrusted "$tmp_pkg" 2>&1)
        ret=$?
    else
        install_out=$(opkg install --force-reinstall "$tmp_pkg" 2>&1)
        ret=$?
    fi

    rm -f "$tmp_pkg"

    if [ $ret -eq 0 ]; then
        /etc/init.d/sirin restart >/dev/null 2>&1
        printf '{"ok":true,"message":"Обновление успешно установлено, служба перезапущена"}\n'
    else
        clean_out=$(echo "$install_out" | tr '\r\n"' '   ' | head -c 300)
        printf '{"ok":false,"error":"Ошибка установки: %s"}\n' "$clean_out"
    fi
}

