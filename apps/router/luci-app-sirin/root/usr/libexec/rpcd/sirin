#!/bin/sh

CONFIG_FILE="${CONFIG_FILE:-/etc/sirin/client.toml}"
VERSION="1.6.0"

get_input() {
    if [ "$MODE" = "call" ] && [ -n "$ARG3" ]; then
        echo "$ARG3"
    elif [ "$MODE" != "call" ] && [ -n "$ARG2" ]; then
        echo "$ARG2"
    else
        cat 2>/dev/null
    fi
}

method_status() {
    pid=$(pgrep -f "/usr/bin/sirin-client" 2>/dev/null | head -n1)
    if [ -z "$pid" ]; then
        pid=$(pgrep -f "sirin-client" 2>/dev/null | head -n1)
    fi

    running=false
    pid_val=0
    uptime_sec=0
    if [ -n "$pid" ] && [ "$pid" -gt 0 ] 2>/dev/null; then
        running=true
        pid_val=$pid
        now=$(date +%s 2>/dev/null || echo 0)
        start=$(date -r "/proc/$pid" +%s 2>/dev/null || stat -c %Y "/proc/$pid" 2>/dev/null || echo 0)
        if [ "$now" -gt 0 ] && [ "$start" -gt 0 ] && [ "$now" -ge "$start" ]; then
            uptime_sec=$((now - start))
        fi
    fi

    enabled=false
    if ls /etc/rc.d/S*sirin >/dev/null 2>&1; then
        enabled=true
    fi

    transport=""
    if [ "$running" = "true" ]; then
        logs=$( (logread 2>/dev/null || cat /var/log/messages 2>/dev/null) | grep -i sirin | tail -n 100 )
        if echo "$logs" | grep -qiE "vless|поток"; then
            transport="vless"
        elif echo "$logs" | grep -qiE "udp|noise"; then
            transport="udp"
        fi
    fi

    printf '{"running":%s,"enabled":%s,"pid":%d,"version":"%s","transport":"%s","uptime_sec":%d}\n' \
        "$running" "$enabled" "$pid_val" "$VERSION" "$transport" "$uptime_sec"
}

method_get_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        printf '{"gateway":"","password":"","device_id":"","ru_direct":false,"tun_mtu":1280,"kill_switch":true,"normalize_ttl":true,"target_ttl":64,"intercept_dns":true,"block_dot":true,"dead_drop_urls":[]}\n'
        return
    fi

    awk '
    BEGIN {
        in_top = 1
        gateway = ""
        password = ""
        device_id = ""
        ru_direct = "false"
        tun_mtu = 1280
        kill_switch = "true"
        normalize_ttl = "true"
        target_ttl = 64
        intercept_dns = "true"
        block_dot = "true"
        dead_drop_urls = ""
        in_dd = 0
    }
    /^\[/ {
        in_top = 0
        in_dd = 0
    }
    in_top && /^[ \t]*gateway[ \t]*=/ {
        if (match($0, /"[^"]*"/)) gateway = substr($0, RSTART + 1, RLENGTH - 2)
    }
    in_top && /^[ \t]*password[ \t]*=/ {
        if (match($0, /"[^"]*"/)) password = substr($0, RSTART + 1, RLENGTH - 2)
    }
    in_top && /^[ \t]*device_id[ \t]*=/ {
        if (match($0, /"[^"]*"/)) device_id = substr($0, RSTART + 1, RLENGTH - 2)
    }
    in_top && /^[ \t]*ru_direct[ \t]*=/ {
        if ($0 ~ /true/i) ru_direct = "true"
        else ru_direct = "false"
    }
    in_top && /^[ \t]*kill_switch[ \t]*=/ {
        if ($0 ~ /false/i) kill_switch = "false"
        else kill_switch = "true"
    }
    in_top && /^[ \t]*tun_mtu[ \t]*=/ {
        sub(/^[ \t]*tun_mtu[ \t]*=[ \t]*/, "")
        if (match($0, /[0-9]+/)) tun_mtu = substr($0, RSTART, RLENGTH)
    }
    in_top && /^[ \t]*normalize_ttl[ \t]*=/ {
        if ($0 ~ /false/i) normalize_ttl = "false"
        else normalize_ttl = "true"
    }
    in_top && /^[ \t]*target_ttl[ \t]*=/ {
        sub(/^[ \t]*target_ttl[ \t]*=[ \t]*/, "")
        if (match($0, /[0-9]+/)) target_ttl = substr($0, RSTART, RLENGTH)
    }
    in_top && /^[ \t]*intercept_dns[ \t]*=/ {
        if ($0 ~ /false/i) intercept_dns = "false"
        else intercept_dns = "true"
    }
    in_top && /^[ \t]*block_dot[ \t]*=/ {
        if ($0 ~ /false/i) block_dot = "false"
        else block_dot = "true"
    }
    in_top && /^[ \t]*dead_drop_urls[ \t]*=[ \t]*\[/ {
        in_dd = 1
    }
    in_dd {
        line = $0
        sub(/^[ \t]*dead_drop_urls[ \t]*=[ \t]*\[/, "", line)
        while (match(line, /"[^"]*"/)) {
            item = substr(line, RSTART + 1, RLENGTH - 2)
            gsub(/"/, "\\\"", item)
            if (dead_drop_urls != "") dead_drop_urls = dead_drop_urls ","
            dead_drop_urls = dead_drop_urls "\"" item "\""
            line = substr(line, RSTART + RLENGTH)
        }
        if ($0 ~ /\]/) in_dd = 0
    }
    END {
        masked_pw = password
        if (length(password) > 8) {
            masked_pw = substr(password, 1, 8) "…"
        }
        gsub(/"/, "\\\"", gateway)
        gsub(/"/, "\\\"", masked_pw)
        gsub(/"/, "\\\"", device_id)
        printf "{\"gateway\":\"%s\",\"password\":\"%s\",\"device_id\":\"%s\",\"ru_direct\":%s,\"tun_mtu\":%d,\"kill_switch\":%s,\"normalize_ttl\":%s,\"target_ttl\":%d,\"intercept_dns\":%s,\"block_dot\":%s,\"dead_drop_urls\":[%s]}\n", gateway, masked_pw, device_id, ru_direct, tun_mtu, kill_switch, normalize_ttl, target_ttl, intercept_dns, block_dot, dead_drop_urls
    }
    ' "$CONFIG_FILE"
}

method_set_config() {
    raw_input="$1"
    if [ -z "$raw_input" ]; then
        raw_input=$(cat 2>/dev/null)
    fi

    eval $(awk -v json="$raw_input" '
    function get_field(k,    val) {
        if (match(json, "\"" k "\"[ \t]*:[ \t]*\"[^\"]*\"")) {
            val = substr(json, RSTART, RLENGTH)
            sub("^\"" k "\"[ \t]*:[ \t]*\"", "", val)
            sub("\"$", "", val)
            return val
        } else if (match(json, "\"" k "\"[ \t]*:[ \t]*[^,}]*")) {
            val = substr(json, RSTART, RLENGTH)
            sub("^\"" k "\"[ \t]*:[ \t]*", "", val)
            gsub(/[ \t]/, "", val)
            return val
        }
        return ""
    }
    function get_array(k,    arr) {
        if (match(json, "\"" k "\"[ \t]*:[ \t]*\\[[^]]*\\]")) {
            arr = substr(json, RSTART, RLENGTH)
            sub("^\"" k "\"[ \t]*:[ \t]*\\[", "", arr)
            sub("\\]$", "", arr)
            return arr
        }
        return ""
    }
    BEGIN {
        gw = get_field("gateway")
        pw = get_field("password")
        did = get_field("device_id")
        rud = get_field("ru_direct")
        mtu = get_field("tun_mtu")
        ks = get_field("kill_switch")
        norm_ttl = get_field("normalize_ttl")
        targ_ttl = get_field("target_ttl")
        int_dns = get_field("intercept_dns")
        blk_dot = get_field("block_dot")
        dd = get_array("dead_drop_urls")
        gsub(/'\''/, "'\''\\'\'''\''", gw)
        gsub(/'\''/, "'\''\\'\'''\''", pw)
        gsub(/'\''/, "'\''\\'\'''\''", did)
        gsub(/'\''/, "'\''\\'\'''\''", rud)
        gsub(/'\''/, "'\''\\'\'''\''", mtu)
        gsub(/'\''/, "'\''\\'\'''\''", ks)
        gsub(/'\''/, "'\''\\'\'''\''", norm_ttl)
        gsub(/'\''/, "'\''\\'\'''\''", targ_ttl)
        gsub(/'\''/, "'\''\\'\'''\''", int_dns)
        gsub(/'\''/, "'\''\\'\'''\''", blk_dot)
        gsub(/'\''/, "'\''\\'\'''\''", dd)
        printf "NEW_GW='\''%s'\''; NEW_PW='\''%s'\''; NEW_DID='\''%s'\''; NEW_RUD='\''%s'\''; NEW_MTU='\''%s'\''; NEW_KS='\''%s'\''; NEW_NORM_TTL='\''%s'\''; NEW_TARG_TTL='\''%s'\''; NEW_INT_DNS='\''%s'\''; NEW_BLK_DOT='\''%s'\''; NEW_DD='\''%s'\'';\n", gw, pw, did, rud, mtu, ks, norm_ttl, targ_ttl, int_dns, blk_dot, dd
    }
    ')

    if [ -z "$NEW_GW" ] || echo "$NEW_GW" | grep -qE "[^a-zA-Z0-9.-]"; then
        printf '{"ok":false,"error":"gateway: неверный формат хоста или IP"}\n'
        return
    fi

    if echo "$NEW_PW" | grep -qE "(…|\.\.\.)"; then
        if [ -f "$CONFIG_FILE" ]; then
            EXISTING_PW=$(awk '
                /^\[/ { exit }
                /^[ \t]*password[ \t]*=/ {
                    if (match($0, /"[^"]*"/)) {
                        print substr($0, RSTART + 1, RLENGTH - 2)
                        exit
                    }
                }
            ' "$CONFIG_FILE")
            if [ -n "$EXISTING_PW" ]; then
                NEW_PW="$EXISTING_PW"
            fi
        fi
    fi

    if [ -z "$NEW_PW" ]; then
        printf '{"ok":false,"error":"password: пустой ключ"}\n'
        return
    fi

    PW_WARN=""
    UUID_REGEX="^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    if ! echo "$NEW_PW" | grep -qE "$UUID_REGEX"; then
        PW_WARN="не похоже на UUID v4"
    fi

    if [ -z "$NEW_DID" ] || echo "$NEW_DID" | grep -qE "[^a-zA-Z0-9._-]" || [ ${#NEW_DID} -gt 64 ]; then
        printf '{"ok":false,"error":"device_id: допустимы символы a-z, 0-9, ., _, -, длина до 64"}\n'
        return
    fi

    if ! echo "$NEW_MTU" | grep -qE "^[0-9]+$" || [ "$NEW_MTU" -lt 576 ] || [ "$NEW_MTU" -gt 1500 ]; then
        printf '{"ok":false,"error":"tun_mtu: должно быть от 576 до 1500"}\n'
        return
    fi

    if [ "$NEW_RUD" != "true" ] && [ "$NEW_RUD" != "false" ]; then
        NEW_RUD="false"
    fi

    if [ "$NEW_KS" != "true" ] && [ "$NEW_KS" != "false" ]; then
        NEW_KS="true"
    fi

    if [ "$NEW_NORM_TTL" != "false" ]; then
        NEW_NORM_TTL="true"
    fi

    if ! echo "$NEW_TARG_TTL" | grep -qE "^[0-9]+$" || [ "$NEW_TARG_TTL" -le 0 ] || [ "$NEW_TARG_TTL" -gt 255 ]; then
        NEW_TARG_TTL="64"
    fi

    if [ "$NEW_INT_DNS" != "false" ]; then
        NEW_INT_DNS="true"
    fi

    if [ "$NEW_BLK_DOT" != "false" ]; then
        NEW_BLK_DOT="true"
    fi

    mkdir -p "$(dirname "$CONFIG_FILE")"
    if [ -f "$CONFIG_FILE" ]; then
        cp "$CONFIG_FILE" "${CONFIG_FILE}.bak.$(date +%s 2>/dev/null || echo $$)"
    fi

    TMP_CONF="/tmp/client.toml.tmp.$$"
    awk -v new_gw="$NEW_GW" \
        -v new_pw="$NEW_PW" \
        -v new_did="$NEW_DID" \
        -v new_rud="$NEW_RUD" \
        -v new_mtu="$NEW_MTU" \
        -v new_ks="$NEW_KS" \
        -v new_norm_ttl="$NEW_NORM_TTL" \
        -v new_targ_ttl="$NEW_TARG_TTL" \
        -v new_int_dns="$NEW_INT_DNS" \
        -v new_blk_dot="$NEW_BLK_DOT" \
        -v new_dd="$NEW_DD" '
    BEGIN {
        in_top = 1
        seen_gw = 0
        seen_pw = 0
        seen_did = 0
        seen_rud = 0
        seen_mtu = 0
        seen_ks = 0
        seen_norm_ttl = 0
        seen_targ_ttl = 0
        seen_int_dns = 0
        seen_blk_dot = 0
        seen_dd = 0
        in_skip_dd = 0
    }
    /^\[/ {
        if (in_top) {
            if (!seen_gw) print "gateway = \"" new_gw "\""
            if (!seen_pw) print "password = \"" new_pw "\""
            if (!seen_did) print "device_id = \"" new_did "\""
            if (!seen_mtu) print "tun_mtu = " new_mtu
            if (!seen_rud) print "ru_direct = " new_rud
            if (!seen_ks) print "kill_switch = " new_ks
            if (!seen_norm_ttl) print "normalize_ttl = " new_norm_ttl
            if (!seen_targ_ttl) print "target_ttl = " new_targ_ttl
            if (!seen_int_dns) print "intercept_dns = " new_int_dns
            if (!seen_blk_dot) print "block_dot = " new_blk_dot
            if (!seen_dd && new_dd != "") print "dead_drop_urls = [" new_dd "]"
            print ""
            in_top = 0
        }
    }
    in_top && /^[ \t]*gateway[ \t]*=/ {
        print "gateway = \"" new_gw "\""
        seen_gw = 1
        next
    }
    in_top && /^[ \t]*password[ \t]*=/ {
        print "password = \"" new_pw "\""
        seen_pw = 1
        next
    }
    in_top && /^[ \t]*device_id[ \t]*=/ {
        print "device_id = \"" new_did "\""
        seen_did = 1
        next
    }
    in_top && /^[ \t]*tun_mtu[ \t]*=/ {
        print "tun_mtu = " new_mtu
        seen_mtu = 1
        next
    }
    in_top && /^[ \t]*ru_direct[ \t]*=/ {
        print "ru_direct = " new_rud
        seen_rud = 1
        next
    }
    in_top && /^[ \t]*kill_switch[ \t]*=/ {
        print "kill_switch = " new_ks
        seen_ks = 1
        next
    }
    in_top && /^[ \t]*normalize_ttl[ \t]*=/ {
        print "normalize_ttl = " new_norm_ttl
        seen_norm_ttl = 1
        next
    }
    in_top && /^[ \t]*target_ttl[ \t]*=/ {
        print "target_ttl = " new_targ_ttl
        seen_targ_ttl = 1
        next
    }
    in_top && /^[ \t]*intercept_dns[ \t]*=/ {
        print "intercept_dns = " new_int_dns
        seen_int_dns = 1
        next
    }
    in_top && /^[ \t]*block_dot[ \t]*=/ {
        print "block_dot = " new_blk_dot
        seen_blk_dot = 1
        next
    }
    in_top && /^[ \t]*dead_drop_urls[ \t]*=[ \t]*\[/ {
        in_skip_dd = 1
        seen_dd = 1
        print "dead_drop_urls = [" new_dd "]"
        next
    }
    in_skip_dd {
        if ($0 ~ /\]/) in_skip_dd = 0
        next
    }
    { print $0 }
    END {
        if (in_top) {
            if (!seen_gw) print "gateway = \"" new_gw "\""
            if (!seen_pw) print "password = \"" new_pw "\""
            if (!seen_did) print "device_id = \"" new_did "\""
            if (!seen_mtu) print "tun_mtu = " new_mtu
            if (!seen_rud) print "ru_direct = " new_rud
            if (!seen_ks) print "kill_switch = " new_ks
            if (!seen_norm_ttl) print "normalize_ttl = " new_norm_ttl
            if (!seen_targ_ttl) print "target_ttl = " new_targ_ttl
            if (!seen_int_dns) print "intercept_dns = " new_int_dns
            if (!seen_blk_dot) print "block_dot = " new_blk_dot
            if (!seen_dd && new_dd != "") print "dead_drop_urls = [" new_dd "]"
        }
    }
    ' "$CONFIG_FILE" > "$TMP_CONF" 2>/dev/null

    if [ -s "$TMP_CONF" ]; then
        mv "$TMP_CONF" "$CONFIG_FILE"
        if [ -n "$PW_WARN" ]; then
            printf '{"ok":true,"warn":"%s"}\n' "$PW_WARN"
        else
            printf '{"ok":true}\n'
        fi
    else
        rm -f "$TMP_CONF"
        printf '{"ok":false,"error":"Не удалось записать конфигурацию"}\n'
    fi
}

method_get_split_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        printf '{"mode":"bypass","use_ru_direct":true,"cidrs":[],"domains":[],"ports":[],"port_mode":"only"}\n'
        return
    fi

    awk '
    BEGIN {
        in_split = 0
        in_cidrs = 0
        in_domains = 0
        in_ports = 0
        mode = "bypass"
        use_ru = "true"
        port_mode = "only"
        cidrs = ""
        domains = ""
        ports = ""
    }
    /^\[split_tunnel\]/ {
        in_split = 1
        next
    }
    /^\[/ && !/^\[split_tunnel\]/ {
        in_split = 0
        in_cidrs = 0
        in_domains = 0
        in_ports = 0
    }
    in_split && /^[ \t]*mode[ \t]*=/ {
        if (match($0, /"[^"]*"/)) mode = substr($0, RSTART + 1, RLENGTH - 2)
    }
    in_split && /^[ \t]*use_ru_direct[ \t]*=/ {
        if ($0 ~ /false/i) use_ru = "false"
        else use_ru = "true"
    }
    in_split && /^[ \t]*port_mode[ \t]*=/ {
        if (match($0, /"[^"]*"/)) port_mode = substr($0, RSTART + 1, RLENGTH - 2)
    }
    in_split && /^[ \t]*cidrs[ \t]*=[ \t]*\[/ {
        in_cidrs = 1
    }
    in_cidrs {
        line = $0
        sub(/^[ \t]*cidrs[ \t]*=[ \t]*\[/, "", line)
        while (match(line, /"[^"]*"/)) {
            item = substr(line, RSTART + 1, RLENGTH - 2)
            gsub(/"/, "\\\"", item)
            if (cidrs != "") cidrs = cidrs ","
            cidrs = cidrs "\"" item "\""
            line = substr(line, RSTART + RLENGTH)
        }
        if ($0 ~ /\]/) in_cidrs = 0
    }
    in_split && /^[ \t]*domains[ \t]*=[ \t]*\[/ {
        in_domains = 1
    }
    in_domains {
        line = $0
        sub(/^[ \t]*domains[ \t]*=[ \t]*\[/, "", line)
        while (match(line, /"[^"]*"/)) {
            item = substr(line, RSTART + 1, RLENGTH - 2)
            gsub(/"/, "\\\"", item)
            if (domains != "") domains = domains ","
            domains = domains "\"" item "\""
            line = substr(line, RSTART + RLENGTH)
        }
        if ($0 ~ /\]/) in_domains = 0
    }
    in_split && /^[ \t]*ports[ \t]*=[ \t]*\[/ {
        in_ports = 1
    }
    in_ports {
        line = $0
        sub(/^[ \t]*ports[ \t]*=[ \t]*\[/, "", line)
        while (match(line, /"[^"]*"|[0-9]+(-[0-9]+)?/)) {
            token = substr(line, RSTART, RLENGTH)
            line = substr(line, RSTART + RLENGTH)
            if (token ~ /^"/) {
                item = substr(token, 2, length(token) - 2)
            } else {
                item = token
            }
            if (item != "") {
                gsub(/"/, "\\\"", item)
                if (ports != "") ports = ports ","
                ports = ports "\"" item "\""
            }
        }
        if ($0 ~ /\]/) in_ports = 0
    }
    END {
        printf "{\"mode\":\"%s\",\"use_ru_direct\":%s,\"cidrs\":[%s],\"domains\":[%s],\"ports\":[%s],\"port_mode\":\"%s\"}\n", mode, use_ru, cidrs, domains, ports, port_mode
    }
    ' "$CONFIG_FILE"
}

method_set_split_config() {
    raw_input="$1"
    if [ -z "$raw_input" ]; then
        raw_input=$(cat 2>/dev/null)
    fi

    eval $(awk -v json="$raw_input" '
    function get_str(k,    val) {
        if (match(json, "\"" k "\"[ \t]*:[ \t]*\"[^\"]*\"")) {
            val = substr(json, RSTART, RLENGTH)
            sub("^\"" k "\"[ \t]*:[ \t]*\"", "", val)
            sub("\"$", "", val)
            return val
        }
        return ""
    }
    function get_bool(k,    val) {
        if (match(json, "\"" k "\"[ \t]*:[ \t]*(true|false)")) {
            val = substr(json, RSTART, RLENGTH)
            sub("^\"" k "\"[ \t]*:[ \t]*", "", val)
            return val
        }
        return ""
    }
    function get_array(k,    subjson, res, item) {
        if (match(json, "\"" k "\"[ \t]*:[ \t]*\\[")) {
            subjson = substr(json, RSTART + RLENGTH)
            if (match(subjson, /\]/)) {
                subjson = substr(subjson, 1, RSTART - 1)
                res = ""
                while (match(subjson, /"[^"]*"/)) {
                    item = substr(subjson, RSTART + 1, RLENGTH - 2)
                    if (res != "") res = res ","
                    res = res item
                    subjson = substr(subjson, RSTART + RLENGTH)
                }
                return res
            }
        }
        return ""
    }
    BEGIN {
        m = tolower(get_str("mode"))
        if (m == "") m = "bypass"
        rud = tolower(get_bool("use_ru_direct"))
        if (rud == "") rud = "true"
        c = get_array("cidrs")
        d = tolower(get_array("domains"))
        p = tolower(get_array("ports"))
        pm = tolower(get_str("port_mode"))
        if (pm == "") pm = "only"

        gsub(/'\''/, "'\''\\'\'''\''", m)
        gsub(/'\''/, "'\''\\'\'''\''", rud)
        gsub(/'\''/, "'\''\\'\'''\''", c)
        gsub(/'\''/, "'\''\\'\'''\''", d)
        gsub(/'\''/, "'\''\\'\'''\''", p)
        gsub(/'\''/, "'\''\\'\'''\''", pm)

        printf "SPLIT_MODE='\''%s'\''; SPLIT_RU='\''%s'\''; SPLIT_CIDRS='\''%s'\''; SPLIT_DOMAINS='\''%s'\''; SPLIT_PORTS='\''%s'\''; SPLIT_PORT_MODE='\''%s'\'';\n", m, rud, c, d, p, pm
    }
    ')

    if [ "$SPLIT_MODE" != "bypass" ] && [ "$SPLIT_MODE" != "only" ]; then
        printf '{"ok":false,"error":"Недопустимый режим mode (только bypass или only)"}\n'
        return
    fi

    if [ "$SPLIT_PORT_MODE" != "only" ] && [ "$SPLIT_PORT_MODE" != "bypass" ]; then
        printf '{"ok":false,"error":"Недопустимый режим port_mode (только only или bypass)"}\n'
        return
    fi

    # Валидация CIDR
    CLEAN_CIDRS=""
    if [ -n "$SPLIT_CIDRS" ]; then
        old_ifs="$IFS"
        IFS=','
        for cidr in $SPLIT_CIDRS; do
            cidr=$(echo "$cidr" | tr -d ' \t\r\n')
            [ -z "$cidr" ] && continue
            if echo "$cidr" | grep -qE '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}(/[0-9]{1,2})?$'; then
                if ! echo "$cidr" | grep -q '/'; then
                    cidr="${cidr}/32"
                fi
                if [ -z "$CLEAN_CIDRS" ]; then
                    CLEAN_CIDRS="$cidr"
                else
                    CLEAN_CIDRS="$CLEAN_CIDRS,$cidr"
                fi
            else
                IFS="$old_ifs"
                printf '{"ok":false,"error":"Неверный CIDR или IP: %s"}\n' "$cidr"
                return
            fi
        done
        IFS="$old_ifs"
    fi

    # Валидация доменов
    CLEAN_DOMAINS=""
    if [ -n "$SPLIT_DOMAINS" ]; then
        old_ifs="$IFS"
        IFS=','
        for dom in $SPLIT_DOMAINS; do
            dom=$(echo "$dom" | tr -d ' \t\r\n' | tr 'A-Z' 'a-z')
            [ -z "$dom" ] && continue
            if echo "$dom" | grep -qE '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}$'; then
                if [ -z "$CLEAN_DOMAINS" ]; then
                    CLEAN_DOMAINS="$dom"
                else
                    CLEAN_DOMAINS="$CLEAN_DOMAINS,$dom"
                fi
            else
                IFS="$old_ifs"
                printf '{"ok":false,"error":"Неверное доменное имя: %s"}\n' "$dom"
                return
            fi
        done
        IFS="$old_ifs"
    fi

    # Валидация портов
    CLEAN_PORTS=""
    if [ -n "$SPLIT_PORTS" ]; then
        old_ifs="$IFS"
        IFS=','
        for p_item in $SPLIT_PORTS; do
            p_item=$(echo "$p_item" | tr -d ' \t\r\n' | tr 'A-Z' 'a-z')
            [ -z "$p_item" ] && continue
            if echo "$p_item" | grep -qE '^(tcp:|udp:)?[0-9]{1,5}(-[0-9]{1,5})?$'; then
                val_part="$p_item"
                case "$val_part" in
                    tcp:*|udp:*) val_part=$(echo "$val_part" | cut -d: -f2) ;;
                esac
                if echo "$val_part" | grep -q '-'; then
                    p_start=$(echo "$val_part" | cut -d- -f1)
                    p_end=$(echo "$val_part" | cut -d- -f2)
                    if [ "$p_start" -lt 1 ] || [ "$p_start" -gt 65535 ] || [ "$p_end" -lt 1 ] || [ "$p_end" -gt 65535 ] || [ "$p_start" -ge "$p_end" ]; then
                        IFS="$old_ifs"
                        printf '{"ok":false,"error":"Неверный диапазон портов: %s"}\n' "$p_item"
                        return
                    fi
                else
                    if [ "$val_part" -lt 1 ] || [ "$val_part" -gt 65535 ]; then
                        IFS="$old_ifs"
                        printf '{"ok":false,"error":"Номер порта вне диапазона 1-65535: %s"}\n' "$p_item"
                        return
                    fi
                fi

                if [ -z "$CLEAN_PORTS" ]; then
                    CLEAN_PORTS="$p_item"
                else
                    CLEAN_PORTS="$CLEAN_PORTS,$p_item"
                fi
            else
                IFS="$old_ifs"
                printf '{"ok":false,"error":"Неверный формат порта или диапазона: %s"}\n' "$p_item"
                return
            fi
        done
        IFS="$old_ifs"
    fi

    mkdir -p "$(dirname "$CONFIG_FILE")"
    if [ -f "$CONFIG_FILE" ]; then
        cp "$CONFIG_FILE" "${CONFIG_FILE}.bak.$(date +%s 2>/dev/null || echo $$)"
    else
        touch "$CONFIG_FILE"
    fi

    TMP_CONF="/tmp/client.toml.split.$$"
    awk -v new_mode="$SPLIT_MODE" \
        -v new_use_ru="$SPLIT_RU" \
        -v new_cidrs="$CLEAN_CIDRS" \
        -v new_domains="$CLEAN_DOMAINS" \
        -v new_ports="$CLEAN_PORTS" \
        -v new_port_mode="$SPLIT_PORT_MODE" '
    BEGIN {
        in_split = 0
        split_written = 0
    }
    function write_split() {
        if (!split_written) {
            print "[split_tunnel]"
            print "mode = \"" new_mode "\""
            print "use_ru_direct = " new_use_ru
            print "cidrs = ["
            n_c = split(new_cidrs, arr_c, ",")
            for (i = 1; i <= n_c; i++) {
                gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", arr_c[i])
                if (arr_c[i] != "") {
                    comma = (i < n_c) ? "," : ""
                    print "    \"" arr_c[i] "\"" comma
                }
            }
            print "]"
            print "domains = ["
            n_d = split(new_domains, arr_d, ",")
            for (i = 1; i <= n_d; i++) {
                gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", arr_d[i])
                if (arr_d[i] != "") {
                    comma = (i < n_d) ? "," : ""
                    print "    \"" arr_d[i] "\"" comma
                }
            }
            print "]"
            print "ports = ["
            n_p = split(new_ports, arr_p, ",")
            for (i = 1; i <= n_p; i++) {
                gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", arr_p[i])
                if (arr_p[i] != "") {
                    comma = (i < n_p) ? "," : ""
                    print "    \"" arr_p[i] "\"" comma
                }
            }
            print "]"
            if (new_ports != "") {
                print "port_mode = \"" new_port_mode "\""
            }
            print ""
            split_written = 1
        }
    }
    /^\[split_tunnel\]/ {
        in_split = 1
        write_split()
        next
    }
    /^\[/ && !/^\[split_tunnel\]/ {
        if (in_split) in_split = 0
        if (!split_written) write_split()
        print $0
        next
    }
    in_split { next }
    { print $0 }
    END {
        if (!split_written) {
            print ""
            write_split()
        }
    }
    ' "$CONFIG_FILE" > "$TMP_CONF" 2>/dev/null

    if [ -s "$TMP_CONF" ]; then
        mv "$TMP_CONF" "$CONFIG_FILE"
        printf '{"ok":true}\n'
    else
        rm -f "$TMP_CONF"
        printf '{"ok":false,"error":"Не удалось обновить секцию split_tunnel"}\n'
    fi
}

