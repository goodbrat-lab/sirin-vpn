{
  "luci-app-sirin": {
    "description": "Sirin VPN — управление Router-клиентом",
    "read": {
      "ubus": {
        "sirin": [
          "status",
          "get_config",
          "get_split_config",
          "get_antidpi_config",
          "get_whitelist_config",
          "get_ru_direct_info",
          "get_logs",
          "test_connection",
          "check_update"
        ]
      },
      "file": {
        "/etc/sirin/client.toml": [ "read" ]
      }
    },
    "write": {
      "ubus": {
        "sirin": [
          "set_config",
          "set_split_config",
          "set_antidpi_config",
          "set_whitelist_config",
          "start",
          "stop",
          "restart",
          "enable",
          "disable",
          "upgrade"
        ]
      },
      "file": {
        "/etc/sirin/client.toml": [ "write" ]
      }
    }
  }
}
