# Sirin Client для OpenWrt
gateway = "crp.guseynovia.ru"
password = "REPLACE_WITH_YOUR_UUID"  # получить в @sirin_crp_bot
device_id = "router-01"

tun_name = "sirin0"
tun_mtu = 1280

lan_interface = "br-lan"
# wan_interface: если пусто, определяется автоматически по маршруту по умолчанию (например, pppoe-wan или eth0)
wan_interface = ""

api_url = "https://crp.guseynovia.ru"

# Раздельное туннелирование (Split Tunneling)
[split_tunnel]
# mode:
#   "bypass" — весь трафик направляется в VPN, за исключением адресов из split-списка (RuDirect, cidrs, domains).
#   "only"   — только адреса из split-списка (cidrs, domains) направляются в VPN, всё остальное идёт напрямую через WAN.
mode = "bypass"

# use_ru_direct:
#   Использовать встроенный список диапазонов IP РФ (8641 CIDR).
#   Действует только в режиме "bypass". В режиме "only" игнорируется с предупреждением в лог.
use_ru_direct = true

# Дополнительные диапазоны IP (IPv4 CIDR или отдельные IP)
cidrs = [
    # "1.1.1.1/32",
    # "104.16.0.0/12"
]

# Домены для включения в список (резолвятся в IP-адреса)
domains = [
    # "rutracker.org",
    # "kinopoisk.ru"
]

# Fallback: если API недоступен, использовать статический пул узлов
[[ladder]]
name = "A"
transport = "udp"
host = "crp.guseynovia.ru"
port = 56005

[[ladder]]
name = "B"
transport = "vless"
host = "crp.guseynovia.ru"
port = 443
sni = "sun8-21.userapi.com"
# Расширенный пул SNI для ротации при блокировках ТСПУ (VK CDN, Kinopoisk, WB, IKEA, Microsoft, Apple, Samsung):
snis = [
    "sun8-21.userapi.com",
    "www.kinopoisk.ru",
    "wildberries.ru",
    "www.ikea.com",
    "www.microsoft.com",
    "dl.delivery.mp.microsoft.com",
    "swcdn.apple.com",
    "www.samsung.com"
]
pbk = "4ll5_ouUJr8P8CCxasWNcNu0Lb7tSIDacGmRskweoH4"
sid = "8283f99ec6a0f52e"

# XHTTP+Reality (экспериментальный транспорт P1 против поведенческого DPI 2026, поддержка в Router v1.3.0+)
# [[ladder]]
# name = "C"
# transport = "xhttp"
# host = "crp.guseynovia.ru"
# port = 8443
# sni = "sun8-21.userapi.com"
# pbk = "4ll5_ouUJr8P8CCxasWNcNu0Lb7tSIDacGmRskweoH4"
# sid = "a4b2c1d3e5f67890"
# path = "/s1r1nxhttp2026k"
# mode = "auto"


